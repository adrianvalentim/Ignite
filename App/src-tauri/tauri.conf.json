{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Effortful Learning",
  "version": "0.1.0",
  "identifier": "com.adrianvalentim.effortful-learning",
  "build": {
    "beforeDevCommand": "pnpm -C frontend dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm -C frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Effortful Learning",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A read-only view of your Effortful Learning workspace",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
